<!-- ============================================================
     FILE: android/app/src/main/res/values/themes.xml
     ============================================================ -->
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xrc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/xrc_dark</item>
        <item name="android:statusBarColor">@color/xrc_dark</item>
        <item name="android:navigationBarColor">@color/xrc_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Xrc.Transparent" parent="Theme.Xrc">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
